# Cerberus AI - Environment Variables
# Copy file ini ke .env dan isi nilai yang diperlukan

# === REQUIRED ===
# API Key Mistral AI (gratis) - Daftar di https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# === OPTIONAL (untuk deployment) ===
# Supabase URL & Key
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Upstash Redis
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# HuggingFace Token
# HF_TOKEN=hf_xxxxx
