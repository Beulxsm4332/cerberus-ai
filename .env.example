# HexStrike AI v6.0 - Environment Variables
# Copy this file to .env and fill in the required values

# === REQUIRED (for AI Chat) ===
# Mistral AI API Key - Get one at https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Gemini API Key - Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === HEXSTRIKE BACKEND (for real security tools) ===
# HexStrike Python backend URL (default: http://127.0.0.1:9999)
# Start the backend: npm run hexstrike (or cd hexstrike && python3 hexstrike_server.py)
HEXSTRIKE_BACKEND_URL=http://127.0.0.1:9999

# === OPTIONAL (for deployment) ===
# Supabase URL & Key
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Upstash Redis
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=
